# Copy this file to retail_intel_agent/.env and fill in your values.
# NEVER commit the real .env file (it is listed in .gitignore).

# Option A: Gemini API key from https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=paste-your-key-here

# Option A2 (production): leave GOOGLE_API_KEY unset and point to a Secret
# Manager secret instead; the key is fetched at startup and never logged.
# GOOGLE_API_KEY_SECRET=projects/your-project-id/secrets/google-api-key/versions/latest

# Option B: Vertex AI (uncomment and set your project)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Model routing
# PRO_MODEL: coordinator, strategy writer, brief reviewer (reasoning).
#   With a paid key you can use PRO_MODEL=gemini-3.1-pro-preview.
# FAST_MODEL: financial + search specialists (fast, cheap tool calling).
PRO_MODEL=gemini-3.5-flash
FAST_MODEL=gemini-3.5-flash-lite

# Persistence (run_cli.py; `make web` passes equivalent URIs to adk web)
SESSION_DB_URL=sqlite+aiosqlite:///.adk/sessions.db
MEMORY_DB_PATH=.adk/memory.db

# Observability
LOG_LEVEL=INFO
ENABLE_CLOUD_TRACE=false

# Context compaction
COMPACTION_INTERVAL=5
COMPACTION_OVERLAP=1
