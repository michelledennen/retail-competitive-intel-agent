# Copy this file to retail_intel_agent/.env and fill in your values.
# NEVER commit the real .env file (it is listed in .gitignore).

# Option A: Gemini API key from https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=paste-your-key-here

# Option B: Vertex AI (uncomment and set your project)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional settings
MODEL=gemini-3.5-flash
LOG_LEVEL=INFO
COMPACTION_INTERVAL=5
COMPACTION_OVERLAP=1
